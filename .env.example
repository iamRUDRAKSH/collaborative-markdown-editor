# Signaling relay the frontend connects to.
# Vite inlines this at BUILD time, so the signaling server must be deployed first and the
# frontend rebuilt afterwards. Changing it later requires a redeploy, not a restart.
#
# Local development (default when unset):
#   ws://localhost:4444
# Cloudflare Worker:
#   wss://ds-signaling.<your-subdomain>.workers.dev
# Render / any Node host:
#   wss://<your-service>.onrender.com
VITE_SIGNALING_URL=wss://ds-signaling.example.workers.dev

# Optional TURN relay. Without these, ICE has only host and STUN candidates, so a peer
# behind a symmetric NAT or a restrictive network cannot connect at all.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
